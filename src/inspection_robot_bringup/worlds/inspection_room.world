<?xml version="1.0" ?>

<sdf version="1.6">

  <world name="inspection_room">

    <!-- 光照 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>


    <!-- ========================= -->
    <!-- 房间四面墙 -->
    <!-- 房间内部大约 6 m × 5 m -->
    <!-- ========================= -->

    <!-- 北墙 -->
    <model name="wall_north">
      <static>true</static>

      <pose>0 2.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 0.1 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.1 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 南墙 -->
    <model name="wall_south">
      <static>true</static>

      <pose>0 -2.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 0.1 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 0.1 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 西墙 -->
    <model name="wall_west">
      <static>true</static>

      <pose>-3.0 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 东墙 -->
    <model name="wall_east">
      <static>true</static>

      <pose>3.0 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ========================= -->
    <!-- 非对称障碍物 -->
    <!-- ========================= -->

    <!-- 左上区域的长方体 -->
    <model name="obstacle_long">
      <static>true</static>

      <pose>-1.2 1.0 0.35 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.4 0.7</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.4 0.7</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 右下区域的小方块 -->
    <model name="obstacle_small">
      <static>true</static>

      <pose>1.5 -1.2 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.8 0.8</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 一段短墙，制造明显拐角 -->
    <model name="inner_wall">
      <static>true</static>

      <pose>0.8 1.3 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 1.4 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 1.4 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

  </world>

</sdf>
