<?xml version="1.0"?>

<robot
  name="inspection_robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 参数表 -->
  <xacro:include filename="robot_properties.xacro"/>

  <!-- 可复用组件宏 -->
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="wheel.xacro"/>
  
  <xacro:include filename="sensors/laser.xacro"/>
  <xacro:include filename="sensors/imu.xacro"/>

  <!-- 创建底盘 -->
  <xacro:base
    length="${base_length}"
    width="${base_width}"
    height="${base_height}"
    mass="${base_mass}"
    base_link_z="${base_link_z}"/>

  <!-- 创建左轮：ROS 坐标系中 Y 正方向为左侧 -->
  <xacro:wheel
    side="left"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"
    x="${wheel_x}"
    y="${wheel_separation / 2.0}"
    z="${wheel_z}"/>

  <!-- 创建右轮：位于 Y 负方向 -->
  <xacro:wheel
    side="right"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"
    x="${wheel_x}"
    y="${-wheel_separation / 2.0}"
    z="${wheel_z}"/>

  <!-- 激光雷达 -->
  <xacro:laser
    x="${laser_x}"
    y="${laser_y}"
    z="${laser_z}"/>

  <!-- IMU -->
  <xacro:imu
    x="${imu_x}"
    y="${imu_y}"
    z="${imu_z}"/>
</robot>
