<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 底盘外形尺寸 -->
  <xacro:property name="base_length" value="0.32"/>
  <xacro:property name="base_width"  value="0.24"/>
  <xacro:property name="base_height" value="0.10"/>
  <xacro:property name="base_mass"   value="4.0"/>

  <!--
    V2 坐标定义：
    base_link 位于左右驱动轮轴线中点，
        高度等于驱动轮半径。
  -->
  <xacro:property name="base_link_z" value="0.05"/>

  <!--
        底盘几何体相对于 base_link 的位置。
        底盘向后偏 4 cm；
        底部离地 3 cm，因此几何中心 z=0.03。
  -->
  <xacro:property name="chassis_x" value="-0.04"/>
  <xacro:property name="chassis_z" value="0.03"/>

  <!--
        简化的整机质心位置。
        重部件假设低位、略微偏后。
  -->
  <xacro:property name="base_com_x" value="-0.05"/>
  <xacro:property name="base_com_z" value="0.00"/>

  <!-- 左右驱动轮 -->
  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.02"/>
  <xacro:property name="wheel_mass"       value="0.30"/>
  <xacro:property name="wheel_separation" value="0.28"/>

  <!-- 驱动轮轴线就是 base_link 的 X=0 -->
  <xacro:property name="wheel_x" value="0.0"/>

  <!--
    base_link 高度已经等于轮半径，
        所以轮心与 base_link 位于同一高度。
  -->
  <xacro:property
    name="wheel_z"
    value="${wheel_radius - base_link_z}"/>

  <!-- 后部支撑球 -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.05"/>

  <xacro:property name="caster_x" value="-0.13"/>
  <xacro:property name="caster_y" value="0.0"/>
  <xacro:property
    name="caster_z"
    value="${caster_radius - base_link_z}"/>
    
  <!-- 2D 激光雷达相对于 base_link 的安装位置 -->
  <xacro:property name="laser_x" value="0.05"/>
  <xacro:property name="laser_y" value="0.0"/>
  <xacro:property name="laser_z" value="0.10"/>

  <!-- IMU 相对于 base_link 的安装位置 -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.03"/>

</robot>
